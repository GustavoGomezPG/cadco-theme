{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"palette": [
				{
					"slug": "cadco-blue",
					"name": "Cadco Blue",
					"color": "#00476e"
				},
				{
					"slug": "true-black",
					"name": "True Black",
					"color": "#000000"
				},
				{
					"slug": "light-grey",
					"name": "Light Grey",
					"color": "#d1d1cf"
				},
				{
					"slug": "paper",
					"name": "White",
					"color": "#ffffff"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"name": "System",
					"slug": "system"
				},
				{
					"fontFamily": "'Inter', ui-sans-serif, system-ui, sans-serif",
					"name": "Inter",
					"slug": "inter"
				},
				{
					"fontFamily": "'Barlow', ui-sans-serif, system-ui, sans-serif",
					"name": "Barlow",
					"slug": "barlow"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"spacing": {
			"blockGap": "0"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}
